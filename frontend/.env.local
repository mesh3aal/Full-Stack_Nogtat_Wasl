# ASP.NET Core Backend URL
NEXT_PUBLIC_API_URL=https://localhost:5001
API_URL=https://localhost:5001

# JWT Secret & Parameters matching WebAPI appsettings.json
ASP_NET_JWT_SECRET=HelloMyNameIsMeshaalAndThisIsTutorialForJWT
ASP_NET_JWT_ISSUER=https://localhost:5001
ASP_NET_JWT_AUDIENCE=https://localhost:5001

# Allow local ASP.NET Core self-signed dev certificate in Node.js
NODE_TLS_REJECT_UNAUTHORIZED=0
